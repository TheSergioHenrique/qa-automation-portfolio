meta {
  name: Create product
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/produtos
  body: json
  auth: none
}

headers {
  Authorization: {{authorization}}
}

body:json {
  {
    "nome": "{{productName}}",
    "preco": 150,
    "descricao": "Produto criado pela collection do Bruno",
    "quantidade": 10
  }
}

script:pre-request {
  bru.setVar("productName", `Produto QA ${Date.now()}`);
}

script:post-response {
  bru.setVar("productId", res.body._id);
}

tests {
  test("should return 201 Created", function () {
    expect(res.status).to.equal(201);
  });

  test("should confirm the registration", function () {
    expect(res.body.message).to.equal("Cadastro realizado com sucesso");
  });
}

meta {
  name: Get deleted product
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/produtos/{{productId}}
  body: none
  auth: none
}

tests {
  test("should return 400 for a deleted product", function () {
    expect(res.status).to.equal(400);
  });

  test("should say the product was not found", function () {
    expect(res.body.message).to.equal("Produto não encontrado");
  });
}

meta {
  name: Login with wrong password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "wrong-password"
  }
}

tests {
  test("should return 401 Unauthorized", function () {
    expect(res.status).to.equal(401);
  });

  test("should not reveal which field is wrong", function () {
    expect(res.body.message).to.equal("Email e/ou senha inválidos");
  });

  test("should not return a token", function () {
    expect(res.body).to.not.have.property("authorization");
  });
}
